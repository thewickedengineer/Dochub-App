# Point the SPA at the API.
VITE_API_URL=http://localhost:5080

# SSO client ids. Leave blank to hide the provider button's happy path;
# the dev sign-in below is enough for local work.
VITE_GOOGLE_CLIENT_ID=
VITE_MICROSOFT_CLIENT_ID=a197e2d2-3af8-4da4-9f93-5f2f50e0b0b2
VITE_MICROSOFT_TENANT=common

# Shows the "Sign in without SSO" box. The API must also have
# Sso:AllowDevSignIn enabled, which appsettings.Development.json does.
VITE_ALLOW_DEV_SIGNIN=true
