# Copy to .env. Every value here has a working default for local development
# except the embedding provider's credentials and the service key.

# ── Dochub ────────────────────────────────────────────────────────────────────
DOCHUB_API_URL=http://localhost:5080
# Must equal Ingestion:ServiceKey in the API (32+ characters).
DOCHUB_SERVICE_KEY=

# ── Queue: Dochub's process queue ─────────────────────────────────────────────
# postgres reads dochub.queue_messages (the API's ServiceBus:Enabled=false mode).
QUEUE_BACKEND=postgres
PROCESS_QUEUE=dochub-document-process-requested
DOCHUB_QUEUE_DSN=postgresql://dochub:dochub@localhost:5432/dochub
# QUEUE_BACKEND=servicebus
# SERVICEBUS_CONNECTION_STRING=Endpoint=sb://…
MAX_ATTEMPTS=5

# ── Storage ───────────────────────────────────────────────────────────────────
RAG_DATABASE_DSN=postgresql://rag:rag@localhost:5433/rag
# BLOB_CONNECTION_STRING defaults to Azurite's devstoreaccount1.
OBJECT_CONTAINER=rag-objects

# ── Embeddings (no fake option: one of these must be real) ────────────────────
EMBEDDING_PROVIDER=azure_openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=1536
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Or run a model on this machine (pip install -e '.[local]'):
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_DIM=384

# ── LLM: summaries, chunk context, chat answers ───────────────────────────────
# none keeps deterministic headers and answers chat with sources only.
LLM_PROVIDER=none                # none | azure_openai | openai | anthropic
LLM_MODEL=                       # azure: chat deployment name; openai: e.g. a mini model; anthropic: default claude-haiku-4-5
CHAT_MODEL=                      # model for chat answers; empty = LLM_MODEL
# Reasoning models (GPT-5, o-series): reasoning tokens count against the output limit.
# none/low keep enrichment fast; the budget is extra output room for reasoning.
LLM_REASONING_EFFORT=            # e.g. none
CHAT_REASONING_EFFORT=           # e.g. low
LLM_REASONING_BUDGET=0           # e.g. 1024 with a reasoning model
# ANTHROPIC_API_KEY=
# Azure OpenAI reuses AZURE_OPENAI_ENDPOINT / AZURE_OPENAI_API_KEY above; OpenAI uses OPENAI_API_KEY.
# Prices per million tokens, for the rag_llm_cost_usd_total metric (0 = not tracked).
LLM_PRICE_INPUT_PER_MTOK=0
LLM_PRICE_CACHED_INPUT_PER_MTOK=0
LLM_PRICE_OUTPUT_PER_MTOK=0
CONTEXT_MAX_CHUNKS=400           # bigger documents keep deterministic headers (cost guard)

# ── Reranking (second stage) ──────────────────────────────────────────────────
RERANK_PROVIDER=none             # none | openrouter | cohere
RERANK_MODEL=                    # openrouter: nvidia/llama-nemotron-rerank-vl-1b-v2:free; cohere: rerank-v3.5
# OPENROUTER_API_KEY=
# COHERE_API_KEY=
COHERE_BASE_URL=https://api.cohere.com
RERANK_CANDIDATES=40             # fused candidates the reranker re-orders
RERANK_MIN_SCORE=0               # drop results scored below this (0 keeps all)
LEXICAL_MATCH=all                # first-stage full text: all | any of the words

# ── PDF / Office / HTML / images (Docling; pip install -e '.[docs]') ─────────
DOCLING_ENABLED=true
OCR_ENGINE=rapidocr              # rapidocr | easyocr | tesseract | ocrmac | auto
MIN_OCR_CONFIDENCE=0.5           # scans below this fail as low_quality_extraction
DOCLING_CONCURRENCY=1            # layout/OCR models are memory-hungry
MAX_PAGES=2000

# ── Audio / video (pip install -e '.[media]' + ffmpeg on PATH) ─────────────────
MEDIA_ENABLED=true
WHISPER_MODEL=small              # tiny | base | small | medium | large-v3 — bigger is slower, better
WHISPER_DEVICE=auto              # auto | cpu | cuda
WHISPER_COMPUTE_TYPE=int8        # int8 on CPU; float16 on a GPU
WHISPER_LANGUAGE=                # empty = detect; or e.g. en
MIN_TRANSCRIPT_CONFIDENCE=0.35   # garbled transcripts fail as low_quality_extraction
MAX_MEDIA_SECONDS=14400

# ── Spreadsheets ──────────────────────────────────────────────────────────────
SHEET_ROWS_PER_ELEMENT=50
MAX_SHEET_ROWS=20000

# ── Concurrency and operations ────────────────────────────────────────────────
WORKER_BATCH_CONCURRENCY=2       # uploads held at once; beyond this the worker stops pulling
TENANT_CONCURRENCY=2             # documents in progress per organization (0 = no cap)
WORKER_METRICS_PORT=9464         # the worker's Prometheus endpoint (0 = off)
# OpenTelemetry tracing, off unless an endpoint is set:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=rag-ingest

# ── Tuning ────────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=4             # documents in progress per worker, across batches
CHUNK_TARGET_TOKENS=450
CHUNK_MAX_TOKENS=800
LOG_JSON=false
