{
  "openapi": "3.0.4",
  "info": {
    "title": "Dochub API",
    "description": "Organizational RAG document hub — SSO, org/team/group/artifact structure, multi-source ingestion into Azure Blob storage, and Service Bus-driven processing.",
    "version": "v1"
  },
  "paths": {
    "/api/auth/sso": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Exchange a Google or Microsoft ID token for a Dochub access token",
        "description": "New users are created on first sign-in but hold no organization until an owner adds them.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SsoSignInRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/auth/switch-organization": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Re-issue the access token scoped to another organization",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SwitchOrganizationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Current user, active organization and memberships",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/connections": {
      "get": {
        "tags": [
          "Connections"
        ],
        "summary": "Source connections for the caller in the active organization",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "Connections"
        ],
        "summary": "Store or refresh a source access token",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConnectSourceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/connections/{connectionId}": {
      "delete": {
        "tags": [
          "Connections"
        ],
        "summary": "Revoke a source connection",
        "parameters": [
          {
            "name": "connectionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/knowledge-base": {
      "get": {
        "tags": [
          "Knowledge base"
        ],
        "summary": "Current RAG state for the organization — counts, per-artifact coverage and source mix",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/notifications": {
      "get": {
        "tags": [
          "Notifications"
        ],
        "summary": "Notifications for the caller, newest first",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "unreadOnly",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/notifications/read": {
      "post": {
        "tags": [
          "Notifications"
        ],
        "summary": "Mark notifications read — all of them when no ids are given",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/organizations": {
      "get": {
        "tags": [
          "Organizations"
        ],
        "summary": "Organizations the caller belongs to",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "Organizations"
        ],
        "summary": "Create an organization (requires the create-organizations privilege)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrganizationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/organizations/current/members": {
      "get": {
        "tags": [
          "Organizations"
        ],
        "summary": "Members of the active organization",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "Organizations"
        ],
        "summary": "Add a member — owner only",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddMemberRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/organizations/current/members/{userId}": {
      "patch": {
        "tags": [
          "Organizations"
        ],
        "summary": "Change a member's level — owner only",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateMemberRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "delete": {
        "tags": [
          "Organizations"
        ],
        "summary": "Remove a member — owner only",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/artifacts/{artifactId}/process": {
      "post": {
        "tags": [
          "Processing"
        ],
        "summary": "Queue every pending document on an artifact for indexing",
        "description": "Returns 202 with the acknowledgement the UI shows as a toast. The job is\nadded to the Processing list, a 'started' notification is raised, the\nrequest is published to the Azure Service Bus processing queue, and a\n'complete' notification follows when the indexer finishes.",
        "parameters": [
          {
            "name": "artifactId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProcessArtifactRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/processing-jobs": {
      "get": {
        "tags": [
          "Processing"
        ],
        "summary": "Processing list for the active organization",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "artifactId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/processing-jobs/{jobId}": {
      "get": {
        "tags": [
          "Processing"
        ],
        "summary": "One processing job with its per-document outcome",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/uploads/staging": {
      "post": {
        "tags": [
          "Uploads"
        ],
        "summary": "Stage local files or a zipped folder before registering an upload",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/artifacts/{artifactId}/uploads": {
      "post": {
        "tags": [
          "Uploads"
        ],
        "summary": "Register a source against an artifact",
        "description": "Step 1 of the upload contract. Writes the upload_batches row plus one\nuploaded_documents row per declared document and returns 202 immediately.\nThe pipeline then extracts the source, uploads each document to Azure Blob\nstorage under teams/{team}/groups/{group}/artifacts/{artifact}/{uploadedAt},\nwrites the blob path back onto each row, and publishes the uploaded event\nto the Azure Service Bus queue.",
        "parameters": [
          {
            "name": "artifactId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUploadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "get": {
        "tags": [
          "Uploads"
        ],
        "summary": "Upload history for an artifact",
        "parameters": [
          {
            "name": "artifactId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/uploads/{uploadBatchId}": {
      "get": {
        "tags": [
          "Uploads"
        ],
        "summary": "Status of one uploaded source, with per-document detail",
        "parameters": [
          {
            "name": "uploadBatchId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/teams": {
      "get": {
        "tags": [
          "Workspace"
        ],
        "summary": "Team → group → artifact tree for the active organization",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "Workspace"
        ],
        "summary": "Create a team — any member may do this",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTeamRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/teams/{teamId}/groups": {
      "post": {
        "tags": [
          "Workspace"
        ],
        "summary": "Create a group inside a team",
        "parameters": [
          {
            "name": "teamId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateGroupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/groups/{groupId}/artifacts": {
      "post": {
        "tags": [
          "Workspace"
        ],
        "summary": "Create an artifact inside a group",
        "parameters": [
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateArtifactRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/artifacts": {
      "get": {
        "tags": [
          "Workspace"
        ],
        "summary": "Flat artifact list — drives the upload destination picker",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/artifacts/{artifactId}": {
      "get": {
        "tags": [
          "Workspace"
        ],
        "summary": "Artifact with its documents and upload history",
        "parameters": [
          {
            "name": "artifactId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddMemberRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "type": "string",
            "nullable": true
          },
          "canCreateOrganizations": {
            "type": "boolean",
            "nullable": true
          },
          "displayName": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ConnectSourceRequest": {
        "type": "object",
        "properties": {
          "sourceType": {
            "type": "string",
            "nullable": true
          },
          "accessToken": {
            "type": "string",
            "nullable": true
          },
          "refreshToken": {
            "type": "string",
            "nullable": true
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "scopes": {
            "type": "string",
            "nullable": true
          },
          "displayName": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateArtifactRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "category": {
            "type": "string",
            "nullable": true
          },
          "primarySource": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateGroupRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateOrganizationRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "plan": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateTeamRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateUploadRequest": {
        "type": "object",
        "properties": {
          "sourceType": {
            "type": "string",
            "nullable": true
          },
          "sourceReference": {
            "type": "string",
            "nullable": true
          },
          "sourceConnectionId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "options": {
            "nullable": true
          },
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DeclaredDocument"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "DeclaredDocument": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "relativePath": {
            "type": "string",
            "nullable": true
          },
          "sizeBytes": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "contentType": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ProcessArtifactRequest": {
        "type": "object",
        "properties": {
          "documentIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "SsoSignInRequest": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "nullable": true
          },
          "idToken": {
            "type": "string",
            "nullable": true
          },
          "organizationId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "SwitchOrganizationRequest": {
        "type": "object",
        "properties": {
          "organizationId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "UpdateMemberRequest": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "nullable": true
          },
          "canCreateOrganizations": {
            "type": "boolean",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "description": "Token from POST /api/auth/sso.",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    { }
  ],
  "tags": [
    {
      "name": "Auth"
    },
    {
      "name": "Connections"
    },
    {
      "name": "Knowledge base"
    },
    {
      "name": "Notifications"
    },
    {
      "name": "Organizations"
    },
    {
      "name": "Processing"
    },
    {
      "name": "Uploads"
    },
    {
      "name": "Workspace"
    }
  ]
}