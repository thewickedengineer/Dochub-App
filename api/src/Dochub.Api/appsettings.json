{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=dochub;Username=dochub;Password=dochub;Include Error Detail=true"
  },
  "Database": {
    "AutoMigrate": true,
    "Seed": false,
    "SeedOwnerEmail": "owner@acme-insurance.com"
  },
  "Jwt": {
    "Issuer": "dochub-api",
    "Audience": "dochub-web",
    "SigningKey": "",
    "AccessTokenMinutes": 480
  },
  "Sso": {
    "GoogleClientId": "",
    "MicrosoftClientId": "",
    "MicrosoftTenant": "common",
    "AllowDevSignIn": false
  },
  "AzureStorage": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "Container": "dochub-documents",
    "AccountUrl": ""
  },
  "ServiceBus": {
    "Enabled": false,
    "ConnectionString": "",
    "Namespace": "",
    "ExtractQueue": "dochub-source-upload-requested",
    "ProcessQueue": "dochub-document-process-requested"
  },
  "Pipeline": {
    "StagingPath": ""
  },
  "Cors": {
    "Origins": [
      "http://localhost:5173"
    ]
  },
  "Sync": {
    "Enabled": true,
    "PollIntervalSeconds": 60,
    "MaxPerSweep": 5,
    "DefaultTimeZone": "UTC"
  },
  "Extractor": {
    "Enabled": true,
    "IdlePollSeconds": 2
  },
  "VectorService": {
    "SimulateLocally": false,
    "SimulatedSecondsPerDocument": 2
  },
  "OAuth": {
    "RedirectUri": "http://localhost:5173/oauth/callback",
    "Google": {
      "ClientId": "",
      "ClientSecret": "",
      "AuthorizeEndpoint": "https://accounts.google.com/o/oauth2/v2/auth",
      "TokenEndpoint": "https://oauth2.googleapis.com/token",
      "Scopes": "openid email https://www.googleapis.com/auth/drive.readonly"
    },
    "Microsoft": {
      "ClientId": "",
      "ClientSecret": "",
      "Tenant": "common",
      "Scopes": "openid email offline_access Files.Read.All Sites.Read.All"
    }
  }
}