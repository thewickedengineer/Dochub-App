{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=dochub;Username=dochub;Password=dochub;Include Error Detail=true"
  },
  "Database": {
    "AutoMigrate": true,
    "Administrators": [],
    "_comment_Administrators": "Emails granted Admin on every organization plus the create-organizations right, re-applied on every start. Use it to bootstrap the first account, since a user with no membership cannot otherwise create an organization."
  },
  "Jwt": {
    "Issuer": "dochub-api",
    "Audience": "dochub-web",
    "SigningKey": "",
    "AccessTokenMinutes": 480
  },
  "Sso": {
    "GoogleClientId": "",
    "MicrosoftClientId": "a197e2d2-3af8-4da4-9f93-5f2f50e0b0b2",
    "MicrosoftTenant": "common",
    "AllowDevSignIn": false
  },
  "AzureStorage": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "Container": "dochub-documents",
    "AccountUrl": ""
  },
  "ServiceBus": {
    "Enabled": false,
    "ConnectionString": "",
    "Namespace": "",
    "ExtractQueue": "dochub-source-upload-requested",
    "ProcessQueue": "dochub-document-process-requested"
  },
  "Pipeline": {
    "StagingPath": ""
  },
  "Cors": {
    "Origins": [
      "http://localhost:5173"
    ]
  },
  "Sync": {
    "Enabled": true,
    "PollIntervalSeconds": 60,
    "MaxPerSweep": 5,
    "DefaultTimeZone": "UTC"
  },
  "Extractor": {
    "Enabled": true,
    "IdlePollSeconds": 2
  },
  "OAuth": {
    "RedirectUri": "http://localhost:5173/oauth/callback",
    "Google": {
      "ClientId": "",
      "ClientSecret": "",
      "AuthorizeEndpoint": "https://accounts.google.com/o/oauth2/v2/auth",
      "TokenEndpoint": "https://oauth2.googleapis.com/token",
      "Scopes": "openid email https://www.googleapis.com/auth/drive.readonly"
    },
    "Microsoft": {
      "ClientId": "a197e2d2-3af8-4da4-9f93-5f2f50e0b0b2",
      "ClientSecret": "",
      "Tenant": "common",
      "Scopes": "openid email offline_access Files.Read.All Sites.Read.All"
    }
  },
  "Platform": {
    "Creators": [ "bhavik.can89@gmail.com" ],
    "_comment_Creators": "Sign-in addresses with the Creator role: create organizations and assign their owners. Synced on every start — removing an address revokes the role."
  },
  "Rag": {
    "BaseUrl": "http://localhost:8090",
    "TimeoutSeconds": 180,
    "HistoryMessages": 12
  },
  "Ingestion": {
    "ServiceKey": ""
  }
}